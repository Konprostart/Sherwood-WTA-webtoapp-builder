<!--
  Multi-site app type icon = web icon × 3.
  Visual: 1 on top + 2 below, triangular layout, three separate small globes.

  Key constraints (avoid repeating the "solid black blob" mistake):
  - All paths use only strokeColor; fillColor is always transparent (#00000000).
    Compose's Icon(painter, tint=...) treats the whole vector as an alpha mask and monochromes it,
    so any fillColor would render as solid and must be avoided.
  - The three circles do not overlap, so no evenOdd-style compositing tricks are needed.

  Stroke weight / "paper-like" tuning:
  - In the same 24×24 equivalent area, a single-globe icon has one circle + a few lines; here 3 are packed in,
    so total ink is 3× a single icon. Using the same stroke width (1.6) would look overall too dark.
  - Reduced to 1.0 stroke (outer circle) / 0.9 (inner lines), close to the density of system line icons.
  - Radius also reduced to 5.6 (previously 7) to leave more negative space around the triangle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- ========= Globe 1: top center, center (24, 13), radius 5.6 ========= -->
    <path
        android:pathData="M 24 13 m -5.6 0 a 5.6 5.6 0 1 0 11.2 0 a 5.6 5.6 0 1 0 -11.2 0 z"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.0"/>
    <path
        android:pathData="M 18.4 13 H 29.6"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M 24 7.4 V 18.6"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M 24 7.4 C 21.2 9.5 21.2 16.5 24 18.6 C 26.8 16.5 26.8 9.5 24 7.4 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="0.9"/>

    <!-- ========= Globe 2: bottom left, center (14, 33), radius 5.6 ========= -->
    <path
        android:pathData="M 14 33 m -5.6 0 a 5.6 5.6 0 1 0 11.2 0 a 5.6 5.6 0 1 0 -11.2 0 z"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.0"/>
    <path
        android:pathData="M 8.4 33 H 19.6"
        android:fillColor="#00000000"
