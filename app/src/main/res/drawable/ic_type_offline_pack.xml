<!--
  Website offline-pack icon.
  Visual meaning: cloud + downward arrow, representing "downloading the whole site from the web and packing it".
  Style: same thin-stroke lines as ic_type_html, keeping the "paper feel".

  Constraints:
  - Use only strokeColor; fillColor is always transparent — so Compose's Icon(tint=...)
    monochromes correctly without solid black blocks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- ========= Cloud outline =========
         Standard cloud shape made of 4 arcs: one small arc on each side + two large arcs in the middle. -->
    <path
        android:pathData="
            M 14 32
            A 6 6 0 0 1 14 20
            A 8 8 0 0 1 28 18
            A 6 6 0 0 1 36 22
            A 5 5 0 0 1 36 32
            Z"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"/>

    <!-- ========= Downward arrow (attached below the cloud) =========
         Vertical line + V-shaped arrowhead -->
    <path
        android:pathData="M 25 28 V 40"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M 20 35 L 25 40 L 30 35"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
</vector>
