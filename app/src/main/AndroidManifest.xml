        <!-- Baseline app-list visibility: every package with a launcher entry.
             The standard flavor adds QUERY_ALL_PACKAGES for the rest. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
    ==========================================================================
    android:enableOnBackInvokedCallback="true"
    ==========================================================================
    Android 13+ "predictive back" gesture requires the app to explicitly declare this
    flag; otherwise OEM (Huawei / Xiaomi / OPPO / Samsung, etc.) edge-back gestures / triangle
    back keys **bypass** the old OnBackPressedDispatcher, and the default behavior is to finish() the current
    Activity, so swiping back inside a webapp **exits straight to the home screen** instead of going back to
    the previous page.

    With this flag on, AndroidX activity 1.8+ OnBackPressedDispatcher will
    automatically bridge to the system OnBackInvokedDispatcher — all existing
    OnBackPressedCallback / BackHandler need no changes and will receive back gesture / triangle-key events on Android 13+,
    and navigate back through web history via the existing WebView.goBack() logic.
    (existing behavior unchanged).

    Android 12 and below ignore this flag; behavior is exactly as before.
    ==========================================================================
    -->
    <application
        android:name=".WebToAppApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebToApp"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:pageSizeCompat="enabled"
        tools:targetApi="31">

        
        <meta-data
            android:name="com.sherwood.wta.WTA_APP_MARKER"
            android:value="true" />

        
        <property
            android:name="android.app.property.PAGE_SIZE_COMPATIBILITY"
            android:value="16" />

        
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WebToApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.sherwood.wta"
                    android:host="oauth2callback" />
            </intent-filter>

            <!-- Browser intent: handle http/https URLs so Android offers Sherwood WTA as a browser -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- Share intent: receive text/URLs from other apps via share sheet -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        
        
