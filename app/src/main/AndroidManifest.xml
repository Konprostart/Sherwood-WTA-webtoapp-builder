            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WebToApp.Shell" />

        <!-- Separate recents task. Home preview uses it when that switch is on. The preview tool always does. -->
        <activity
            android:name=".ui.webview.WebViewDocumentActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="standard"
            android:documentLaunchMode="intoExisting"
            android:maxRecents="15"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WebToApp.Shell" />

        
        
        <activity
            android:name=".ui.shell.ShellActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WebToApp.Shell" />

        <activity
            android:name=".ui.shell.DownloadSaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.WebToApp.Transparent" />
        
        
        
        <activity
            android:name=".ui.media.MediaAppActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.WebToApp.Fullscreen" />
        
        
        <activity
            android:name=".ui.gallery.GalleryPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.WebToApp.Fullscreen" />
        
        
        <activity
            android:name=".ui.codepreview.HtmlPreviewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WebToApp" />

        
        
        <activity
            android:name=".ui.splash.SplashLauncherActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WebToApp.Transparent" />

        
        <provider
