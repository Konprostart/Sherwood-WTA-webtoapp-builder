            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        
        <service
            android:name=".core.agent.runtime.AgentService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            ApkBuildService - foreground keep-alive service during APK builds.
            Long builds (runtime injection for Node/Python etc.) are easily reclaimed by the system in the background; this holds a dataSync
            foreground notification + partial wake lock to ensure the export runs to completion.
        -->
        <service
            android:name=".core.apkbuilder.ApkBuildService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            WebMediaPlaybackService - foreground keep-alive service for media playback inside WebView.
            The audio itself still plays inside the WebView; this service provides a mediaPlayback foreground service + wake lock +
            media notification lifecycle (start while playing / detach on pause / remove on stop).
        -->
        <service
            android:name=".core.webview.WebMediaPlaybackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <!--
            NodeService - separate child-process container for the embedded Node.js runtime.
            
            Why a separate OS process:
              libnode.so, once dlopen'ed and V8 is initialized, **can never be reset**. If it ran in the main process:
                1) A user's server.js throwing SyntaxError / calling process.exit would kill the host process
                2) Switching projects, or retrying after a crash, would be impossible; the user would have to swipe the
                   app away from the recent-tasks list and reopen it — a very poor user experience
              Confined to the :nodejs child process, V8 stays inside that process and the main process stays rock-solid.
              To restart V8, the main process makes the child kill itself and the Android Framework recreates it — invisible to the user.
            
            android:process=":nodejs"  → separate OS process within the same APK (leading colon means
                                          private process; shares UID with webtoapp
                                          but is a separate process forked from zygote)
            isolatedProcess=false      → we need access to filesDir / nativeLibraryDir,
                                          which isolatedProcess mode would not allow
            stopWithTask=false         → when the user swipes the App away from recents, the child process still
                                          dies with it (true is the default; spelled out for
                                          clarity — to avoid assuming the child outlives
                                          the main process)
        -->
        <service
            android:name=".core.nodejs.NodeService"
            android:enabled="true"
            android:exported="false"
            android:process=":nodejs"
            android:stopWithTask="true" />

        <!--
            BootReceiver / ScheduledStartReceiver
            Host use: users can configure "autostart a webapp at boot" and "scheduled start" in the host;
                    BootReceiver also supports shell child APKs (behaviorally equivalent java-override,
                    including restoring the notification service after boot/update — changes must be synced on both sides).
        -->
        <receiver
            android:name=".core.autostart.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.autostart.ScheduledStartReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sherwood.wta.ACTION_SCHEDULED_START" />
            </intent-filter>
        </receiver>

        <!--
            Port query / release receivers
            Host use: cross-webapp port coordination (when Node/PHP/Python/Go runtimes coexist).
            exported=true because multiple APKs packaged by Sherwood WTA need to broadcast port queries to each other.
        -->
        <receiver
            android:name=".core.port.PortQueryReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.sherwood.wta.action.PORT_QUERY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.port.PortReleaseReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.sherwood.wta.action.PORT_RELEASE" />
            </intent-filter>
        </receiver>

        <!--
            BridgeAlarmReceiver - notification scheduling (in-page Web Notification.scheduleNotification).
            Used by both the host and generated APKs (NativeBridge is shell-synced code); the shell template manifest
            must keep the same-named declaration; both sides must be changed together.
        -->
        <receiver
            android:name=".core.notification.BridgeAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sherwood.wta.bridge.SCHEDULED_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <service
            android:name=".core.background.BackgroundRunService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="background_run" />
        </service>

        
        <service
            android:name=".core.notification.NotificationPollingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="notification_polling" />
        </service>

        
        <service
            android:name=".core.notification.NotificationWebSocketService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="notification_websocket" />
        </service>
        
        <service
            android:name=".core.notification.NotificationFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        
        
        <service
            android:name=".core.floatingwindow.FloatingWindowService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_window" />
        </service>
    
    </application>

</manifest>
